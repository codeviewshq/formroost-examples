# Browser path: public sandbox submission URL. Safe to expose (it is an address, not a secret).
# Add http://localhost:3000 to the form's sandbox Allowed origins.
NEXT_PUBLIC_FORMROOST_ENDPOINT=https://formroost.com/s/v1/sandbox/fpub_REPLACE_ME

# Server path (src/app/api/contact/route.ts). Never prefix these with NEXT_PUBLIC_.
FORMROOST_SERVER_ENDPOINT=https://formroost.com/s/v1/sandbox/fpub_REPLACE_ME
# Project API key for the same environment (fr_sandbox_key_... or fr_production_key_...).
# Optional in sandbox, required for production server submissions.
FORMROOST_API_KEY=
